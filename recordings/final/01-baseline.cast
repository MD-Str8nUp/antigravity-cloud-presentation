[0.0, "o", "nventory-experiment/audio_inventory_baseline/public/app.js#L498\u0007esc(p.doc_url)\u001b[m\u001b]8;;\u0007 escapes HTML characters, it does not validate the URL scheme. If a \u001b[94mjavascript:...\u001b[m\r\n\u001b[6CURL is sent to the API (or edited when bypassing client validation), clicking \"Build Docs / Schematic\" executes\r\n\u001b[6Carbitrary JavaScript.\n\u001b[21D• \u001b[1mFix\u001b[m: Validate that \u001b[94mdoc_url\u001b[m uses \u001b[94mhttp:\u001b[m or \u001b[94mhttps:\u001b[m via \u001b[94mnew URL()\u001b[m on both the backend and frontend before\r\n\u001b[6Crendering \u001b[94mhref\u001b[m.\r\n  2. \u001b[1mProject Readiness Over-Counts Shared Component Stock Across Multiple BOM Lines\u001b[m\n\u001b[77D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jkccdccaa612138963;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L470-L488\u0007getAllProjects\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jkff1d29ee38cc9ab3;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L517-L540\u0007getProjectDetail\u001b[m\u001b]8;;\u0007.\n\u001b[48D• \u001b[1mIssue\u001b[m: Each BOM line independently checks \u001b[94mcomp.qty_available >= stillNeeded"]
[0.0, "o", "\u001b[m without decrementing a running\r\n\u001b[6Cavailable balance across lines. If a project (or multiple lines in the same project) references the same\r\n\u001b[6Ccomponent twice requiring 10 units each, and \u001b[94mqty_available\u001b[m is 10, both lines are marked \u001b[94min_stock\u001b[m / \u001b[94mreadyLines++\u001b[m\r\n\u001b[6Ceven though total demand is 20.\n\u001b[31D•\r\n\n⣷  \u001b[90mWorking\u001b[94m...\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m───────────────────────────────────────────────────────────────────────────────────────────"]
