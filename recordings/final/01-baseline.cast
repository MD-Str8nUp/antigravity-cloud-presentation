[0.017, "o", "\u001b[?2026h\r\u001b[29A      and \u001b[94mtextContent\u001b[m construction, and added preventative security headers in \u001b]8;id=jk5cdf4c72c3fe6999;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L16-L28\u001b\\\u001b[4;34;4ms\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mv\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4mj\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4m1\u001b[m\u001b[4;34;4m6\u001b[m\u001b[4;34;4m-\u001b[m\u001b[4;34;4m2\u001b[m\u001b[4;34;4m8\u001b[m\u001b]8;;\u001b\\.\u001b[K\r\n\u001b[?5W\u001b[J  2. \u001b[1mAccurate Multi-Line BOM Stock Readiness & Query Optimization\u001b[m:\n\u001b[60D• Updated \u001b[34;4m\u001b]8;id=jk490aed703b7bbe2f;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L444-L526\u0007getAllProjects\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk21ccba8da19ccc7b;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L531-L609\u0007getProjectDetail\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jkab7aef7602de7ee4;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L614-L713\u0007getShoppingList\u001b[m\u001b]8;;\u0007 to eliminate N+1 \u001b[94mbom_items"]
[0.0, "o", "\u001b[m queries and track a\r\n\u001b[6Crunning \u001b[94mremainingAvail\u001b[m balance per \u001b[94mcomponent_id\u001b[m across BOM lines so shared components are not double-counted.\r\n  3. \u001b[1mAllocation Invariant Clamping\u001b[m:\n\u001b[29D• Added \u001b[34;4m\u001b]8;id=jkd512849962a5fca7;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L49-L66\u0007clampComponentAllocations\u001b[m\u001b]8;;\u0007 when \u001b[94mqty_on_hand\u001b[m is reduced in \u001b[94mPUT /api/components/:id\u001b[m or \u001b[94mPATCH\u001b[m\n\u001b[97D\u001b[94m/api/components/:id/stock\u001b[m, and clamped \u001b[94mqty_allocated\u001b[m to \u001b[94mqty_required\u001b[m when updating a BOM line in \u001b[94mPUT\u001b[m\r\n\u001b[6C\u001b[94m/api/bom/:bomId\u001b[m (\u001b[34;4m\u001b]8;id=jka449b3359e8fcfb5;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L677-L705\u0007server.js:677-705\u001b[m\u001b]8;;\u0007).\r\n  4. \u001b[1mElectronic Value Normalization\u001b[m:\n\u001b[30D• Enhanced \u001b[34;4m\u001b]8;id=jk14d0c51fec30db23;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L81-L122\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007 to hand"]
[0.0, "o", "le trailing ohm symbols after middle-decimal notation (\u001b[94m4k7Ω\u001b[m → \u001b[94m4.7k\u001b[m)\r\n\u001b[6Cand unify plain numeric ohms with \u001b[94mR\u001b[m/\u001b[94mΩ\u001b[m suffixes (\u001b[94m470\u001b[m, \u001b[94m470R\u001b[m, \u001b[94m470.0Ω\u001b[m → \u001b[94m470r\u001b[m).\r\n  5. \u001b[1mMultiline CSV Parsing, Error Toasts & Mobile BOM Table Alignment\u001b[m:\n\u001b[64D• Updated \u001b[34;4m\u001b]8;id=jk97dcd9678b9441a2;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L900-L958\u0007parseCsvText\u001b[m\u001b]8;;\u0007 to tokenize character-by-character so quoted multiline fields are preserved.\n\u001b[99D• Updated \u001b[34;4m\u001b]8;id=jk856dc1602e819a88;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L198-L211\u0007api\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk6b7a89f186c20865;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L156-L167\u0007announceStatus\u001b[m\u001b]8;;\u0007 (plus a global \u001b[94munhandledrejection\u001b[m listener) to announce and style API errors\r\n\u001b[6Cvia \u001b[94m.toast-region.is-error\u001b[m.\n\u001b[27D• Fixed \u001b[94m#"]
[0.0, "o", "bom-table\u001b[m stacked mobile labels (\u001b[94m--label-1: \"Soldered\"\u001b[m) and added \u001b[94morder: -1\u001b[m on \u001b[94mtbody th\u001b[m in\n\u001b[99D\u001b[34;4m\u001b]8;id=jk4dfcfa630a399cf6;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/styles.css#L678-L744\u0007styles.css:678-744\u001b[m\u001b]8;;\u0007 so the designator header stays at the top of each mobile card.\r\n\n\n  \u001b[1m### Modern Web Guidance\u001b[m\r\n\n  • \u001b[94mresponsive-table\u001b[m: Aligned \u001b[94m#bom-table\u001b[m's \u001b[94m--label-1\u001b[m through \u001b[94m--label-10\u001b[m custom properties with its leading checkbox\r\n  \u001b[94m<td>\u001b[m and ordered \u001b[94mtbody th\u001b[m first in the \u001b[94m< 680px\u001b[m container query so the sticky row header remains at the top of each\r\n  stacked card without shifting column labels (\"/* MANDATORY: Map the label for each column */\").\r\n  • \u001b[94msecurity\u001b[m: Replaced \u001b[94mvendorLine.innerHTML\u001b[m template concatenation with \u001b[94mdocument.createElement\u001b[m and \u001b[94mtextContent\u001b[m\r\n  alongside protocol validation and baseline response headers (\u001b[94mX-Content-Type-Options: nos"]
