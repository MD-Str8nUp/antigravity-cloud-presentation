[0.017, "o", "\u001b[?2026h\u001b[27A• \u001b[1mDatabase & Smart BOM Engine\u001b[m: \u001b[34;4m\u001b]8;id=jk2c4e3d710fde4e79;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js\u0007db.js\u001b[m\u001b]8;;\u0007 — SQLite schema (\u001b[94mcomponents\u001b[m, \u001b[94mprojects\u001b[m, \u001b[94mbom_items\u001b[m, \u001b[94mbuild_logs\u001b[m), electronic\r\n  value normalization (\u001b[34;4m\u001b]8;id=jka8bd0f674ec4b076;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L71-L109\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007) that equates notation variants like \u001b[94m4k7\u001b[m/\u001b[94m4.7kΩ\u001b[m or \u001b[94m0.1uF\u001b[m/\u001b[94m100nF\u001b[m, and\r\n  BOM-to-inventory matching (\u001b[34;4m\u001b]8;id=jk636d69047e08c26c;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L132-L195\u0007findBestComponentMatch\u001b[m\u001b]8;;\u0007).\u001b[K\r\n  • \u001b[1mBackend API Server\u001b[m: \u001b[34;4m\u001b]8;id=jk541b15cb7765ec83;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js\u0007server.js\u001b[m\u001b]8;;\u0007 — Express endpoints for inventory CRUD, quick stock steppers, project BOM\r\n  "]
[0.0, "o", "management, part allocation/reservation, consumption into builds, build logs, and shopping list aggregation.\r\n  • \u001b[1mFrontend UI & Styles\u001b[m: \u001b[34;4m\u001b]8;id=jk27a1546c3c4a4523;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/index.html\u0007index.html\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk917cb49946fc6138;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/styles.css\u0007styles.css\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk5989f6a0771cb64a;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js\u0007app.js\u001b[m\u001b]8;;\u0007.\u001b[K\r\n\u001b[K\n  \u001b[1m### What's Included\u001b[m\r\n\u001b[K\n  1. \u001b[1mComponents Inventory (\u001b[94;22mOn Hand\u001b[39;1m vs. \u001b[94;22mAllocated\u001b[39;1m vs. \u001b[94;22mAvailable\u001b[39;1m)\u001b[m:\r\n      • Tailored categories and footprints for Eurorack & guitar pedals (\u001b[94mSMD 0603\u001b[m/\u001b[94m0805\u001b[m, \u001b[94mTHT Axial 1/4W\u001b[m, \u001b[94mDIP-8\u001b[m, \u001b[94mSSOP-\u001b[m\r\n\u001b[6C\u001b[94m16\u001b[m, \u001b[94mAlpha 9mm Vertical\u001b[m, \u001b[94mAlpha 16mm PCB\u001b[m, \u001b[94mThonkiconn\u001b[m, \u001b[94m3PDT\u001b[m, \u001b[94m125B E"]
