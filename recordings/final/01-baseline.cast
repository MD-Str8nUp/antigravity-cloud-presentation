[6.014, "o", "\u001b[?2026h\u001b[0 q\r\u001b[30A  • **N+1 Queries in \u001b[34;4m\u001b]8;id=jk8eb341cf1f90abc2;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L441-L503\u0007getAllProjects\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jkf3a45d3d631eff30;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L587-L679\u0007getShoppingList\u001b[m\u001b]8;;\u0007**:\r\n      • Both functions query \u001b[94mSELECT * FROM bom_items WHERE project_id = ?\u001b[m inside a loop over all projects. Fetching\r\n      all relevant \u001b[94mbom_items\u001b[m in a single query and grouping by \u001b[94mproject_id\u001b[m in memory (or via SQL \u001b[94mJOIN\u001b[m) will avoid\r\n\u001b[6Crepeated prepared statement creation and execution on every \u001b[94m/api/overview\u001b[m load.\r\n  • \u001b[1mCSV Parser Line Splitting on Quoted Newlines\u001b[m:\u001b[K\n\u001b[44D\u001b[1K • \u001b[34;4m\u001b]8;id=jk2bf0e9ad5caf323c;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L870-L922\u0007parseCsvText\u001b[m\u001b]8;;\u0007 splits on \u001b[94m/\\r?\\n/\u001b[m before parsing quotes, which will break if a CSV cell "]
