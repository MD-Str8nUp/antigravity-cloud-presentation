[0.018, "o", "\u001b[?2026h\u001b[29A• \u001b[1mZero-Dependency SQLite Persistence\u001b[m: Uses Node's built-in \u001b[94mnode:sqlite\u001b[m (\u001b[94mDatabaseSync\u001b[m) in \u001b[34;4m\u001b]8;id=jk82b544006caca1c;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L1-L16\u0007db.js:1-16\u001b[m\u001b]8;;\u0007 with WAL mode\r\n  and foreign key cascades (\u001b[94mON DELETE CASCADE\u001b[m / \u001b[94mON DELETE SET NULL\u001b[m), keeping the dependency footprint to just Express\r\n  5 (\u001b[34;4m\u001b]8;id=jkc34abea14eebb72c;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/package.json#L10-L12\u0007package.json:10-12\u001b[m\u001b]8;;\u0007).\u001b[K\r\n  • \u001b[1mDomain-Aware BOM Matching\u001b[m: \u001b[34;4m\u001b]8;id=jk8d05b0535c041724;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L81-L119\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk1cb0f14bd2d9133e;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L121-L141\u0007normalizeFootprint\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk7a898a173c07293b;file:///Users/brett/Demos/audio-invento"]
[0.0, "o", "ry-experiment/audio_inventory_baseline/db.js#L146-L210\u0007findBestComponentMatch\u001b[m\u001b]8;;\u0007 handle R/k/M\r\n  decimal notation (\u001b[94m4k7\u001b[m → \u001b[94m4.7k\u001b[m), capacitor unit conversions (\u001b[94m0.1uF\u001b[m → \u001b[94m100nF\u001b[m), and footprint penalties.\u001b[K\r\n  • \u001b[1mModern Web & Accessibility Practices\u001b[m:\u001b[K\r\n      • Uses native \u001b[94m<dialog closedby=\"any\">\u001b[m with pointer-outside fallback in \u001b[34;4m\u001b]8;id=jkccff76774c565b00;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L16-L51\u0007initDialogs\u001b[m\u001b]8;;\u0007.\r\n\tImplements CSS \u001b[94mlight-dark()\u001b[m theming with \u001b[94m@media (prefers-color-scheme: dark)\u001b[m fallback and \u001b[94m<meta name=\"color-\u001b[m\r\n\u001b[6C\u001b[94mscheme\">\u001b[m syncing in \u001b[34;4m\u001b]8;id=jk8168a73aae3b220a;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/styles.css#L3-L130\u0007styles.css:3-130\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jkbbd3e39d2dc07b5b;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L54-L92\u0007initThemeToggle\u001b"]
