[0.033, "o", "\u001b[?2026h\r\u001b[29A      • Container-query responsive tables (\u001b[94m@container (width < 680px)\u001b[m) in \u001b]8;id=jk90855d90cc0ffb14;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/styles.css#L596-L740\u001b\\\u001b[4;34;4ms\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4my\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4m5\u001b[m\u001b[4;34;4m9\u001b[m\u001b[4;34;4m6\u001b[m\u001b[4;34;4m-\u001b[m\u001b[4;34;4m7\u001b[m\u001b[4;34;4m4\u001b[m\u001b[4;34;4m0\u001b[m\u001b]8;;\u001b\\ and polite live-region\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6Cannouncements via \u001b[34;4m\u001b]8;id=jk475b7291fd75d035;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L156-L165\u0007announceStatus\u001b[m\u001b]8;;\u0007.\r\n\n  ──────\r\n  \u001b[1m### 2. Bugs & Logic Issues\u001b[m\r\n\n  1. \u001b[1mXSS / Unsafe Protocol in Project \u001b[94;22mdoc_url\u001b[39;1m Link\u001b[m\n\u001b[44D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk3d2a0e6973e147d1;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L496-L499\u0007renderProjectWorkspace\u001b[m\u001b]8;;\u0007 and \u001b["]
[0.0, "o", "34;4m\u001b]8;id=jk6962d97113db24d9;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L244-L273\u0007POST /api/projects\u001b[m\u001b]8;;\u0007 / \u001b[34;4m\u001b]8;id=jka4ada80f27b8fa27;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L275-L311\u0007PUT /api/projects/:id\u001b[m\u001b]8;;\u0007.\n\u001b[82D• \u001b[1mIssue\u001b[m: While \u001b[34;4m\u001b]8;id=jke1afabff80cb63ca;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L498\u0007esc(p.doc_url)\u001b[m\u001b]8;;\u0007 escapes HTML characters, it does not validate the URL scheme. If a \u001b[94mjavascript:...\u001b[m\r\n\u001b[6CURL is sent to the API (or edited when bypassing client validation), clicking \"Build Docs / Schematic\" executes\r\n\u001b[6Carbitrary JavaScript.\n\u001b[21D• \u001b[1mFix\u001b[m: Validate that \u001b[94mdoc_url\u001b[m uses \u001b[94mhttp:\u001b[m or \u001b[94mhttps:\u001b[m via \u001b[94mnew URL()\u001b[m on both the backend and frontend before\r\n\u001b[6Crendering \u001b[94mhref\u001b[m.\r\n  2. \u001b[1mProject Readiness Over-Counts Shared Component Stock Across Multiple BOM Lines\u001b[m\n\u001b[77D• \u001b[1mL"]
[0.0, "o", "ocation\u001b[m: \u001b[34;4m\u001b]8;id=jkeb3294f584fe2c39;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L470-L488\u0007getAllProjects\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk4c2bdbf50d13425d;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L517-L540\u0007getProjectDetail\u001b[m\u001b]8;;\u0007.\n\u001b[48D• \u001b[1mIssue\u001b[m: Each BOM line independently checks \u001b[94mcomp.qty_available >= stillNeeded\u001b[m without decrementing a running\r\n\u001b[6Cavailable balance across lines. If a project (or multiple lines in the same project) references the same\r\n\u001b[6Ccomponent twice requiring 10 units each, and \u001b[94mqty_available\u001b[m is 10, both lines are marked \u001b[94min_stock\u001b[m / \u001b[94mreadyLines++\u001b[m\r\n\u001b[6Ceven though total demand is 20.\n\u001b[31D• \u001b[1mFix\u001b[m: Track a running map of remaining available stock per \u001b[94mcomponent_id\u001b[m while iterating BOM lines (similar to\r\n\u001b[6Chow \u001b[34;4m\u001b]8;id=jkfb12058b9ace7ac6;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L487-L525\u0007POST /api/p"]
[0.0, "o", "rojects/:id/allocate-all\u001b[m\u001b]8;;\u0007 uses \u001b[94mavailMap\u001b[m).\r\n  3. \u001b[1mReducing \u001b[94;22mqty_required\u001b[39;1m Below \u001b[94;22mqty_allocated\u001b[39;1m Leaves Over-Allocated Stock\u001b[m\n\u001b[68D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk410c90ecb9ada531;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L580-L626\u0007PUT /api/bom/:bomId\u001b[m\u001b]8;;\u0007.\n\u001b[32D• \u001b[1mIssue\u001b[m: If a BOM item has \u001b[94mqty_allocated = 10\u001b[m and the user edits \u001b[94mqty_required\u001b[m down to \u001b[94m4\u001b[m (without changing\r\n\u001b[6C\u001b[94mcomponent_id\u001b[m), \u001b[94mnewAllocated\u001b[m remains \u001b[94m10\u001b[m. Similarly, if \u001b[94mqty_on_hand\u001b[m is reduced in \u001b[34;4m\u001b]8;id=jk11955d75df829d27;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L117-L164\u0007PUT /api/components/:id\u001b[m\u001b]8;;\u0007 or\r\n\u001b[6C[\u001b[94mPATCH /api/compo\u001b[m\r\n\n\n⣷  \u001b[90mWorking...\u001b[m\r\n\u001b[90m──────────────────────────────────────────────────────────"]
