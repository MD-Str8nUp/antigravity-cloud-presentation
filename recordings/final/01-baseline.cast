[0.416, "o", "\u001b[?2026h\r\u001b[29A  3. \u001b[1mAllocation Invariant Clamping\u001b[m:\u001b[K\r\n\tAdded \u001b[34;4m\u001b]8;id=jkc9d75383d89a2aa5;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L49-L66\u0007clampComponentAllocations\u001b[m\u001b]8;;\u0007 when \u001b[94mqty_on_hand\u001b[m is reduced in \u001b[94mPUT /api/components/:id\u001b[m or \u001b[94mPATCH\u001b[m\u001b[K\n\u001b[97D\u001b[94m/api/components/:id/stock\u001b[m, and clamped \u001b[94mqty_allocated\u001b[m to \u001b[94mqty_required\u001b[m when updating a BOM line in \u001b[94mPUT\u001b[m\u001b[K\r\n      \u001b[94m/api/bom/:bomId\u001b[m (\u001b[34;4m\u001b]8;id=jk8b342134dc67fa33;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L677-L705\u0007server.js:677-705\u001b[m\u001b]8;;\u0007).\r\n  4. \u001b[1mElectronic Value Normalization\u001b[m:\u001b[K\n\u001b[30D• Enhanced \u001b[34;4m\u001b]8;id=jk7f7b7b5be4aee14d;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L81-L122\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007 to handle trailing ohm symbols after middle-decimal notation (\u001b[94m4k7Ω\u001b[m → \u001b[94m4.7k\u001b[m)\r\n\u001b[6Cand unify plain numeric ohms with \u001b[94mR\u001b[m"]
[0.0, "o", "/\u001b[94mΩ\u001b[m suffixes (\u001b[94m470\u001b[m, \u001b[94m470R\u001b[m, \u001b[94m470.0Ω\u001b[m → \u001b[94m470r\u001b[m).\r\n  5. \u001b[1mMultiline CSV Parsing, Error Toasts & Mobile BOM Table Alignment\u001b[m:\r\n\tUpdated \u001b[34;4m\u001b]8;id=jk344fb066631bc8e0;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L900-L958\u0007parseCsvText\u001b[m\u001b]8;;\u0007 to tokenize character-by-character so quoted multiline fields are preserved.\u001b[K\n\u001b[99D• Updated \u001b[34;4m\u001b]8;id=jk287de904fcb3ea0e;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L198-L211\u0007api\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk3c6d6757ed598dbb;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L156-L167\u0007announceStatus\u001b[m\u001b]8;;\u0007 (plus a global \u001b[94munhandledrejection\u001b[m listener) to announce and style API errors\r\n      via \u001b[94m.toast-region.is-error\u001b[m.\u001b[K\r\n\tFixed \u001b[94m#bom-table\u001b[m stacked mobile labels (\u001b[94m--label-1: \"Soldered\"\u001b[m) and added \u001b[94morder: -1\u001b[m on \u001b[94mtbody th\u001b[m in\n\u001b[99D\u001b[34;4m\u001b]8;id=jk2d"]
