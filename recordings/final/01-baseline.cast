[0.017, "o", "\u001b[?2026h\r\u001b[29A  • \u001b[1mZero-Dependency SQLite Persistence\u001b[m: Uses Node's built-in \u001b[94mnode:sqlite\u001b[m (\u001b[94mDatabaseSync\u001b[m) in \u001b]8;id=jkcabc9234c2d2dd3;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L1-L16\u001b\\\u001b[4;34;4md\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4mj\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4m1\u001b[m\u001b[4;34;4m-\u001b[m\u001b[4;34;4m1\u001b[m\u001b[4;34;4m6\u001b[m\u001b]8;;\u001b\\ with WAL mode\u001b[K\r\n\u001b[?5W\u001b[J  and foreign key cascades (\u001b[94mON DELETE CASCADE\u001b[m / \u001b[94mON DELETE SET NULL\u001b[m), keeping the dependency footprint to just Express\r\n  5 (\u001b[34;4m\u001b]8;id=jk39d67227279f2d8c;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/package.json#L10-L12\u0007package.json:10-12\u001b[m\u001b]8;;\u0007).\r\n  • \u001b[1mDomain-Aware BOM Matching\u001b[m: \u001b[34;4m\u001b]8;id=jk603f0befd52ecf84;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L81-L119\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk2936ef6fa65a3d9e;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baselin"]
[0.0, "o", "e/db.js#L121-L141\u0007normalizeFootprint\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk24a8052fe7f1a91b;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L146-L210\u0007findBestComponentMatch\u001b[m\u001b]8;;\u0007 handle R/k/M\r\n  decimal notation (\u001b[94m4k7\u001b[m → \u001b[94m4.7k\u001b[m), capacitor unit conversions (\u001b[94m0.1uF\u001b[m → \u001b[94m100nF\u001b[m), and footprint penalties.\r\n  • \u001b[1mModern Web & Accessibility Practices\u001b[m:\n\u001b[35D• Uses native \u001b[94m<dialog closedby=\"any\">\u001b[m with pointer-outside fallback in \u001b[34;4m\u001b]8;id=jk69eb4ca0a3b4fee0;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L16-L51\u0007initDialogs\u001b[m\u001b]8;;\u0007.\n\u001b[83D• Implements CSS \u001b[94mlight-dark()\u001b[m theming with \u001b[94m@media (prefers-color-scheme: dark)\u001b[m fallback and \u001b[94m<meta name=\"color-\u001b[m\r\n\u001b[6C\u001b[94mscheme\">\u001b[m syncing in \u001b[34;4m\u001b]8;id=jk1034ccc9c60296a;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/styles.css#L3-L130\u0007styles.css:3-130\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk4accbdfed4da"]
