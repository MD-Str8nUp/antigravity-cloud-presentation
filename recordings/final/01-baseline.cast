[0.007, "o", "\u001b[?2026h\r\u001b[27A  The server is running at \u001b[94m\u001b]8;id=jk1d30cbeccbe8b649;http://localhost:3000\u001b\\http://localhost:3000\u001b]8;;\u001b\\\u001b[m with persistent local SQLite storage in \u001b[94mdata/inventory.sqlite\u001b[m.\u001b[K\r\n\u001b[?5W\u001b[J\n  \u001b[1m### Architecture & Key Files\u001b[m\r\n\n  • \u001b[1mDatabase & Smart BOM Engine\u001b[m: \u001b[34;4m\u001b]8;id=jkcef240e17c18da52;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js\u0007db.js\u001b[m\u001b]8;;\u0007 — SQLite schema (\u001b[94mcomponents\u001b[m, \u001b[94mprojects\u001b[m, \u001b[94mbom_items\u001b[m, \u001b[94mbuild_logs\u001b[m), electronic\r\n  value normalization (\u001b[34;4m\u001b]8;id=jk1d40d17a2630f44f;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L71-L109\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007) that equates notation variants like \u001b[94m4k7\u001b[m/\u001b[94m4.7kΩ\u001b[m or \u001b[94m0.1uF\u001b[m/\u001b[94m100nF\u001b[m, and\r\n  BOM-to-inventory matching (\u001b[34;4m\u001b]8;id=jkd724c0eac0b74647;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L132-L195\u0007findBestComponentMatch\u001b[m\u001b]8;;\u0007).\r\n  • \u001b[1mBacke"]
[0.0, "o", "nd API Server\u001b[m: \u001b[34;4m\u001b]8;id=jk4871a340edd8fe2c;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js\u0007server.js\u001b[m\u001b]8;;\u0007 — Express endpoints for inventory CRUD, quick stock steppers, project BOM\r\n  management, part allocation/reservation, consumption into builds, build logs, and shopping list aggregation.\r\n  • \u001b[1mFrontend UI & Styles\u001b[m: \u001b[34;4m\u001b]8;id=jk10c52d3f5b598b78;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/index.html\u0007index.html\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk59ac27e314c6b98f;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/styles.css\u0007styles.css\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk11c2395ba94f965d;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js\u0007app.js\u001b[m\u001b]8;;\u0007.\r\n\n  \u001b[1m### What's Included\u001b[m\r\n\n  1. \u001b[1mComponents Inventory (\u001b[94;22mOn Hand\u001b[39;1m vs. \u001b[94;22mAllocated\u001b[39;1m vs. \u001b[94;22mAvailable\u001b[39;1m)\u001b[m:\n\u001b[58D• Tailored categories and footprints fo"]
[0.0, "o", "r Eurorack & guitar pedals (\u001b[94mSMD 0603\u001b[m/\u001b[94m0805\u001b[m, \u001b[94mTHT Axial 1/4W\u001b[m, \u001b[94mDIP-8\u001b[m, \u001b[94mSSOP-\u001b[m\r\n\u001b[6C\u001b[94m16\u001b[m, \u001b[94mAlpha 9mm Vertical\u001b[m, \u001b[94mAlpha 16mm PCB\u001b[m, \u001b[94mThonkiconn\u001b[m, \u001b[94m3PDT\u001b[m, \u001b[94m125B Enclosure\u001b[m).\n\u001b[74D• Tracks storage locations/bins, supplier & SKU (\u001b[94mMouser\u001b[m, \u001b[94mTayda\u001b[m, \u001b[94mThonk\u001b[m, \u001b[94mStompBoxParts\u001b[m), unit cost, and low-stock\r\n\u001b[6Calert thresholds.\n\u001b[17D• Instant filtering by search query, category, footprint type (\u001b[94mSMD\u001b[m, \u001b[94mTHT\u001b[m, \u001b[94mPanel & Hardware\u001b[m), and stock status\r\n\u001b[6C(\u001b[94mLow Available\u001b[m, \u001b[94mCurrently Allocated\u001b[m, \u001b[94mZero Available\u001b[m).\r\n  2. \u001b[1mDIY Kit Builds & Part Allocation\u001b[m:\n\u001b[32D• Track build stages (\u001b[94mPlanning\u001b[m, \u001b[94mParts Ordered\u001b[m, \u001b[94mReady to Build\u001b[m, \u001b[94mSoldering\u001b[m, \u001b[94mTesting & Calibration\u001b[m,\n\u001b[96D\u001b[94mTroubleshooting / On Hold\u001b[m, \u001b[94mCompleted\u001b[m).\n\u001b[38D• \u001b[1mReserve / Allocate Parts\u001b[m: Allocate parts per BOM line or click \u001b[1mAllocate All Available Parts\u001b[m to reserve parts\r\n\u001b[6"]
