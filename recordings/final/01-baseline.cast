[0.049, "o", "\u001b[?2026h\r\u001b[29A      • \u001b[1mIssue\u001b[m: While \u001b]8;id=jka030980097d76109;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L498\u001b\\\u001b[4;34;4me\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4m(\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4m_\u001b[m\u001b[4;34;4mu\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4m)\u001b[m\u001b]8;;\u001b\\ escapes HTML characters, it does not validate the URL scheme. If a \u001b[94mjavascript:...\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6CURL is sent to the API (or edited when bypassing client validation), clicking \"Build Docs / Schematic\" executes\r\n\u001b[6Carbitrary JavaScript.\n\u001b[21D• \u001b[1mFix\u001b[m: Validate that \u001b[94mdoc_url\u001b[m uses \u001b[94mhttp:\u001b[m or \u001b[94mhttps:\u001b[m via \u001b[94mnew URL()\u001b[m on both the backend and frontend before\r\n\u001b[6Crendering \u001b[94mhref\u001b[m.\r\n  2. \u001b[1mProject Readiness Over-Counts Shared Component Stock Across Multiple BOM Lines\u001b[m\n\u001b[77D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk82ffb432f3437950;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L470-L4"]
[0.0, "o", "88\u0007getAllProjects\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jkbd71956b9f38b618;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L517-L540\u0007getProjectDetail\u001b[m\u001b]8;;\u0007.\n\u001b[48D• \u001b[1mIssue\u001b[m: Each BOM line independently checks \u001b[94mcomp.qty_available >= stillNeeded\u001b[m without decrementing a running\r\n\u001b[6Cavailable balance across lines. If a project (or multiple lines in the same project) references the same\r\n\u001b[6Ccomponent twice requiring 10 units each, and \u001b[94mqty_available\u001b[m is 10, both lines are marked \u001b[94min_stock\u001b[m / \u001b[94mreadyLines++\u001b[m\r\n\u001b[6Ceven though total demand is 20.\n\u001b[31D• \u001b[1mFix\u001b[m: Track a running map of remaining available stock per \u001b[94mcomponent_id\u001b[m while iterating BOM lines (similar to\r\n\u001b[6Chow \u001b[34;4m\u001b]8;id=jk9f59b0ef057d43cf;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L487-L525\u0007POST /api/projects/:id/allocate-all\u001b[m\u001b]8;;\u0007 uses \u001b[94mavailMap\u001b[m).\r\n  3. \u001b[1mReducing \u001b[94;22mqty_required\u001b[39;1m Below \u001b[94;22mqty_allocated\u001b[39"]
[0.0, "o", ";1m Leaves Over-Allocated Stock\u001b[m\n\u001b[68D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk640a846c1ab611a4;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L580-L626\u0007PUT /api/bom/:bomId\u001b[m\u001b]8;;\u0007.\n\u001b[32D• \u001b[1mIssue\u001b[m: If a BOM item has \u001b[94mqty_allocated = 10\u001b[m and the user edits \u001b[94mqty_required\u001b[m down to \u001b[94m4\u001b[m (without changing\r\n\u001b[6C\u001b[94mcomponent_id\u001b[m), \u001b[94mnewAllocated\u001b[m remains \u001b[94m10\u001b[m. Similarly, if \u001b[94mqty_on_hand\u001b[m is reduced in \u001b[34;4m\u001b]8;id=jk68ee82527a452cb6;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L117-L164\u0007PUT /api/components/:id\u001b[m\u001b]8;;\u0007 or\r\n\u001b[6C\u001b[34;4m\u001b]8;id=jk14f419d136411610;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L166-L181\u0007PATCH /api/components/:id/stock\u001b[m\u001b]8;;\u0007 below total allocated units, \u001b[94mqty_allocated\u001b[m can exceed \u001b[94mqty_on_hand\u001b[m.\n\u001b[98D• \u001b[1mFix\u001b[m: Clamp \u001b[94mnewAllocated\u001b[m or warn when \u001b[94mqty_on_hand < qty_allocated\u001b[m.\r\n  4. \u001b[1mResist"]
[0.0, "o", "or Normalization Misses Plain Ohms Without Suffix & Megaohm Case Distinction\u001b[m\n\u001b[81D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jkdc03f4568113cedf;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L81-L119\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007.\n\u001b[37D• \u001b[1mIssue\u001b[m:\n\u001b[4D• Lowercasing converts \u001b[94m1M\u001b[m (Megaohm) and \u001b[94m1m\u001b[m (milliohm) to the same \u001b[94m'1m'\u001b[m, and \u001b[94m100\u001b[m vs \u001b[94m100R\u001b[m normalize to \u001b[94m'100'\u001b[m\r\n\t  vs \u001b[94m'100r'\u001b[m (so a BOM line with value \u001b[94m100\u001b[m won't get the exact +60 value score against a \u001b[94m100R\u001b[m component).\r\n\t  • \u001b[94m1uF\u001b[m without a decimal is matched by \u001b[94mcapMatch\u001b[m, but \u001b[94m1u5\u001b[m (without trailing \u001b[94mF\u001b[m) turns into \u001b[94m1.5u\u001b[m which is also\r\n\t  matche\r\n\n\n⣽  \u001b[90mW\u001b[94morkin\u001b[90mg...\u001b[m\r\n\u001b[90m──────────────────────────────────────────────────────────────────────────────"]
