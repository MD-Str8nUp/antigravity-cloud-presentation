[0.016, "o", "\u001b[?2026h\r\u001b[29A      • \u001b[1mLocation\u001b[m: \u001b]8;id=jkb69de80a9749f74a;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L580-L626\u001b\\\u001b[4;34;4mP\u001b[m\u001b[4;34;4mU\u001b[m\u001b[4;34;4mT\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4m/\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4m/\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mm\u001b[m\u001b[4;34;4m/\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mm\u001b[m\u001b[4;34;4mI\u001b[m\u001b[4;34;4md\u001b[m\u001b]8;;\u001b\\.\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6C• \u001b[1mIssue\u001b[m: If a BOM item has \u001b[94mqty_allocated = 10\u001b[m and the user edits \u001b[94mqty_required\u001b[m down to \u001b[94m4\u001b[m (without changing\r\n\u001b[6C\u001b[94mcomponent_id\u001b[m), \u001b[94mnewAllocated\u001b[m remains \u001b[94m10\u001b[m. Similarly, if \u001b[94mqty_on_hand\u001b[m is reduced in \u001b[34;4m\u001b]8;id=jk8a21e08287597770;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L117-L164\u0007PUT /api/components/:id\u001b[m\u001b]8;;\u0007 or\r\n\u001b[6C\u001b[34;4m\u001b]8;id=jkdb39549298e891ae;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/server.js#L166-L181\u0007PATCH /api/components/:id/sto"]
[0.0, "o", "ck\u001b[m\u001b]8;;\u0007 below total allocated units, \u001b[94mqty_allocated\u001b[m can exceed \u001b[94mqty_on_hand\u001b[m.\n\u001b[98D• \u001b[1mFix\u001b[m: Clamp \u001b[94mnewAllocated\u001b[m or warn when \u001b[94mqty_on_hand < qty_allocated\u001b[m.\r\n  4. \u001b[1mResistor Normalization Misses Plain Ohms Without Suffix & Megaohm Case Distinction\u001b[m\n\u001b[81D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk2b48ab8e46370bc5;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/db.js#L81-L119\u0007normalizeElectronicValue\u001b[m\u001b]8;;\u0007.\n\u001b[37D• \u001b[1mIssue\u001b[m:\n\u001b[4D• Lowercasing converts \u001b[94m1M\u001b[m (Megaohm) and \u001b[94m1m\u001b[m (milliohm) to the same \u001b[94m'1m'\u001b[m, and \u001b[94m100\u001b[m vs \u001b[94m100R\u001b[m normalize to \u001b[94m'100'\u001b[m\r\n\t  vs \u001b[94m'100r'\u001b[m (so a BOM line with value \u001b[94m100\u001b[m won't get the exact +60 value score against a \u001b[94m100R\u001b[m component).\r\n\t  • \u001b[94m1uF\u001b[m without a decimal is matched by \u001b[94mcapMatch\u001b[m, but \u001b[94m1u5\u001b[m (without trailing \u001b[94mF\u001b[m) turns into \u001b[94m1.5u\u001b[m which is also\r\n\t  matched by \u001b[94mcapMatch\u001b[m—however \u001b[94m4k7\u001b[m with trailing \u001b[94mΩ\u001b[m ("]
[0.0, "o", "\u001b[94m4k7Ω\u001b[m → \u001b[94m4k7r\u001b[m) fails \u001b[94mrkmMatch\u001b[m (\u001b[94m/^(\\d+)([rkmnup])(\\d+)(f?)$/\u001b[m)\r\n\t  because of the trailing \u001b[94mr\u001b[m.\r\n\n  5. \u001b[1mUnhandled Promise Rejections in UI Event Listeners\u001b[m\n\u001b[49D• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jkb984b45a3cbfd60b;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L999-L1516\u0007app.js:999-1516\u001b[m\u001b]8;;\u0007.\n\u001b[28D• \u001b[1mIssue\u001b[m: Async event handlers call \u001b[34;4m\u001b]8;id=jkfe47e73b8cfed2a;file:///Users/brett/Demos/audio-inventory-experiment/audio_inventory_baseline/public/app.js#L183-L194\u0007api(...)\u001b[m\u001b]8;;\u0007 without \u001b[94mtry / catch\u001b[m. When an API request returns a \u001b[94m400\u001b[m or \u001b[94m500\u001b[m error,\r\n\u001b[6C\u001b[94mapi()\u001b[m throws an \u001b[94mError\u001b[m, resulting in an unhandled promise rejection in the console and no user feedback in\r\n\u001b[6C\u001b[94m#status-announcer\u001b[m.\n\u001b[18D• \u001b[1mFix\u001b[m: Wrap API calls (or catch inside \u001b[94mapi()\u001b[m) to call \u001b[94mannounceStatus(err.message)\u001b[m on failure.\r\n\n  ──────\r\n  \u001b[1m### 3. Performance & Code Quali"]
