[2.820, "o", "\u001b[?2026h\u001b[20A\b\u001b[33m┃\u001b[m \u001b[37m    let cte_res = conn.query(\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7b\"WITH RECURSIVE path_cte(id, name, parent_id, path) AS (\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[11bSELECT id, name, parent_id, name FROM storage_locations WHERE parent_id IS NULL\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[11bUNION ALL\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[11bSELECT s.id, s.name, s.parent_id, p.path || ' > ' || s.name\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[11bFROM storage_locations s JOIN path_cte p ON s.parent_id = p.id\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7b)\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7bSELECT id, path FROM path_cte ORDER BY path\",\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7b(),\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m    ).await;\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m    match cte_res {\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7bOk(mut rows) => {\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[11bwhile let Some(row) = rows.next().await? {\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m\u001b[16X\u001b[16Cprintln!(\"CTE row: {} -> {}\", row.get::<String>(0)?, row.get::<String>(1)?);\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[11b}\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7b}\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7bErr(e)"]
