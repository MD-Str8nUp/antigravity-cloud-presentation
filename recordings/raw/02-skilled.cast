[3.286, "o", "\u001b[?2026h\u001b[3A\b\u001b[33m┃\u001b[m \u001b[37m\u001b[16X\u001b[16CCOALESCE((SELECT SUM(s.quantity) FROM stock_lots s WHERE s.component_id = c.id), 0) AS\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37mtotal_on_hand,\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m\u001b[16X\u001b[16CCOALESCE((SELECT SUM(b.quantity_allocated) FROM bom_lines b WHERE b.component_id = c.id AND\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37mb.fulfillment_status = 'Reserved'), 0) AS reserved_qty\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[8bFROM components c WHERE c.id = ?1\",\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m \u001b[7b(\"comp-1\",),\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m    ).await?;\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m    let row = rows.next().await?.unwrap();\u001b[m\u001b[K\r\n \u001b[33m┃\u001b[m \u001b[37m    let id: String = row.get(0)?;\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m    let ohms: Option<f64> = row.get(1)?;\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m    let total: i64 = row.get(2)?;\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m    let reserved: i64 = row.get(3)?;\u001b[m\r\n \u001b[33m┃\u001b[m \u001b[37m    println!(\"Verified schema & subqueries: id={id}, ohms={ohms:?}, total={total}, reserved={reserved}\");\u001b[m\r\n \u001b[33m┃\u001b[m\n\b\u001b[33m┃\u001b[m \u001b[37m    // Verify maud + axum IntoResponse\u001b[m\r\n"]
