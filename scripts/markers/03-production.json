  },
  {
    "label": "4. /to-spec (Cloud Architecture Spec)",
    "pattern": "/to-spec"
  },
  {
    "label": "5. /to-tickets (Migration Slices)",
    "pattern": "/to-tickets"
  },
  {
    "label": "6. /implement (Firestore & Cloud Run)",
    "pattern": "/implement"
  },
  {
    "label": "7. Live Cloud Run Deployment",
    "pattern": "gcloud run deploy|\\.run\\.app"
  }
]
