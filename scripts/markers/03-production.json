  {
    "label": "1. Install Google Cloud Skills",
    "pattern": "npx skills@latest add google/skills"
  },
  {
    "label": "2. Launch agy",
    "pattern": "\\bagy\\b"
  },
  {
    "label": "3. /wayfinder (Cloud Migration Map)",
