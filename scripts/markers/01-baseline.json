[
  {
    "label": "1. Create Project Directory",
    "pattern": "mkdir(?P<p>\\s+-p)?\\s+audio_inventory_baseline"
  },
  {
    "label": "2. Launch agy",
    "pattern": "\\bagy\\b"
  },
  {
    "label": "3. Initial Prompt",
    "pattern": "I'd like to build a web application to track my audio electronics components inventory and DIY kit builds"
  },
  {
    "label": "4. Build Summary",
    "pattern": "What Was Built|127\\.0\\.0\\.1|localhost:"
  },
  {
    "label": "5. Clear Session (/clear)",
    "pattern": "/clear"
  },
  {
    "label": "6. Session Cleared",
    "pattern": "Antigravity CLI.*?\\? for shortcuts"
  },
  {
    "label": "7. Codebase Review",
    "pattern": "Please review the codebase"
  },
  {
    "label": "8. Apply Review Fixes",
    "pattern": "please fix|p\\s*Gleasefix"
  }
]
