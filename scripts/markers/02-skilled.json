  },
  {
    "label": "5. /to-spec",
    "pattern": "/to-spec"
  },
  {
    "label": "6. /to-tickets",
    "pattern": "/to-tickets"
  },
  {
    "label": "7. /implement",
    "pattern": "/implement"
  },
  {
    "label": "8. Clear Session (/clear)",
    "pattern": "/clear"
  },
  {
    "label": "9. Codebase Review",
    "pattern": "Please review the codebase"
  },
  {
    "label": "10. Apply Review Fixes",
    "pattern": "please fix|p\\s*Gleasefix"
  }
